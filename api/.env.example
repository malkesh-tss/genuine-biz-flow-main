# Copy to .env locally and replace the placeholders with rotated credentials.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
PGHOST=<host>
PGUSER=<user>
PGPASSWORD=<password>
PGDATABASE=<database>
PORT=3001
GMAIL_EMAIL=<gmail-address>
GMAIL_APP_PASSWORD=<gmail-app-password>